{
  "hw_version": "esp32-devkit-v1",
  "wifi": [
    {
      "ssid": "YOUR_WIFI_SSID",
      "password": "YOUR_WIFI_PASSWORD",
      "mqtt_host": "192.168.137.1"
    },
    {
      "ssid": "YOUR_SECOND_WIFI_SSID",
      "password": "YOUR_SECOND_WIFI_PASSWORD",
      "mqtt_host": "192.168.1.20",
      "mqtt_port": 1883
    }
  ],
  "mqtt": {
    "host": "192.168.137.1",
    "port": 1883,
    "keepalive": 30,
    "bootstrap_user": "bootstrap",
    "bootstrap_password": "FROM_deployment/.env"
  },
  "interval_s": 10,
  "provision_retry_s": 10,
  "ntp": true,
  "watchdog_s": 0,
  "sensors": [
    {
      "driver": "dht11",
      "name": "room",
      "pin": 25
    },
    {
      "driver": "simulated",
      "name": "sim"
    }
  ],
  "actuators": [
    {
      "driver": "servo",
      "name": "servo",
      "pin": 14,
      "min_us": 500,
      "max_us": 2400,
      "sequence": {
        "angles": [
          0,
          20,
          40,
          60,
          80,
          100,
          120,
          140,
          160,
          180
        ],
        "step_ms": 1000,
        "autostart": true
      },
      "max_dps": 360,
      "detach_ms": 300,
      "start_delay_ms": 8000
    },
    {
      "driver": "relay",
      "name": "relay",
      "pin": 26,
      "active_low": false,
      "initial": false,
      "max_on_ms": 0
    }
  ]
}
