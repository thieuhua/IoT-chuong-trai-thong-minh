# Copy to deployment/.env (ignored by Git) and change both passwords.
# The backend reads the same file (override with IOT_ENV_FILE); the bootstrap
# password also goes into firmware config.json.
IOT_BROKER_HOST=127.0.0.1
IOT_BROKER_PORT=1883
IOT_BROKER_TLS=0
MQTT_BACKEND_PASSWORD=change-me-backend
MQTT_BOOTSTRAP_PASSWORD=change-me-bootstrap
# Remote backend only (docs/remote-dev.md): adopt approved devices from retained meta.
# IOT_ADOPT_DEVICES=1

# Optional settings below are commented out, so the backend runs with defaults.

# MySQL. Unset: iot_core uses SQLite and the scheduler does not run.
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/iot_db

# JWT login (/auth/*). Required for login: set a long random secret, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=thay_bang_mot_chuoi_bi_mat_dai_va_ngau_nhien
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
